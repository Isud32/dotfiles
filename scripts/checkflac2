#!/bin/bash
shopt -s nullglob

GREEN='\033[38;5;41m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

for f in *.flac; do
    # Quick codec check using ffprobe
    codec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=nokey=1:noprint_wrappers=1 "$f")
    if [ "$codec" != "flac" ]; then
        printf "${RED}NOT a valid FLAC:${NC} $f\n"
        continue
    fi

    # 1. Test integrity with flac -t (or fallback)
    if command -v flac >/dev/null 2>&1; then
        if flac -t "$f" 2>/dev/null; then
            status="${GREEN}OK (verified)${NC}"
        else
            status="${RED}FAILED (corrupt)${NC}"
        fi
    else
        # Fallback: try a quick ffmpeg decode test (fast, but less thorough)
        if ffmpeg -v error -i "$f" -f null - 2>&1 | grep -q "error"; then
            status="${RED}FAILED (ffmpeg error)${NC}"
        else
            status="${GREEN}OK (ffmpeg test)${NC}"
        fi
    fi

    # 2. Gather detailed info (with fallbacks)
    bitrate=$(ffprobe -v error -select_streams a:0 -show_entries format=bit_rate -of default=nokey=1:noprint_wrappers=1 "$f")
    samplerate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of default=nokey=1:noprint_wrappers=1 "$f")
    bitdepth=$(ffprobe -v error -select_streams a:0 -show_entries stream=bits_per_raw_sample -of default=nokey=1:noprint_wrappers=1 "$f")
    if [ -z "$bitdepth" ]; then
        # Fallback to bits_per_sample if raw not available
        bitdepth=$(ffprobe -v error -select_streams a:0 -show_entries stream=bits_per_sample -of default=nokey=1:noprint_wrappers=1 "$f")
    fi

    # 3. Print nicely
    printf "$f: $status\n"
    printf "   "
    if [ -n "$bitrate" ] && [ "$bitrate" -gt 0 ] 2>/dev/null; then
        bitrate_kbps=$((bitrate / 1000))
        echo -n "${bitrate_kbps}kbps | "
    fi
    echo "${samplerate:-?}kHz | ${bitdepth:-?}bit"
done
