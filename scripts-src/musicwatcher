#!/bin/bash
WATCH_DIR="$HOME/.local/share/nicotine/downloads/musicscript"
COMPLETE_DIR="$WATCH_DIR/complete"
GREEN=$'\033[38;5;41m'
RED=$'\033[0;31m'
NC=$'\033[0m'

# This script automates my music dowloading process:
# 1. I dowload from soulseek
# 2. I run this script
# This script looks into a folder and: checkflac2 -> flac to opus -> delete flacs -> change folder name -> move to folder complete
# It depends on the followings scripts:
# checkflac2, flacconvert, cleanup and musicrenamer

